# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/public/pdf.worker.min.mjs

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files; configuration is injected through Infisical
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python development tools
/.venv/
__pycache__/
*.pyc

# Machine-local agent and tooling state; keep generated skills versioned
/.claude/settings.local.json
/.codex/
/.specify/extensions/.cache/
/.specify/extensions/.backup/
/.specify/presets/.cache/
/.specify/presets/.backup/
/graphify-out/cache/
/graphify-out/.graphify_python
/graphify-out/.graphify_root
/graphify-out/.graphify_*.json
/graphify-out/health.json
